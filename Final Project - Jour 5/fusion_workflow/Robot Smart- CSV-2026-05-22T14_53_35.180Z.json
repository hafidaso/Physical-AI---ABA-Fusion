        "id": "c263aed0-caa3-4ffe-98bd-3325e840d4f9",
        "type": "action",
        "data": {
          "description": "Executes custom JavaScript code on the input data.",
          "showRunningStatus": true,
          "_morphing": false,
          "name": "function",
          "label": "Normalize_Telemetry_Data",
          "inputs": {
            "input": {
              "label": "Input"
            }
          },
          "outputs": {
            "success": {
              "label": "Success",
              "isConnectable": null
            },
            "error": {
              "label": "Error",
              "isConnectable": null
            }
          },
          "parameters": {
            "code": "const raw = input.body || input;\n\nfunction asBoolean(value) {\n  return (\n    value === true ||\n    value === \"true\" ||\n    value === 1 ||\n    value === \"1\"\n  );\n}\n\nconst humidityValue =\n  raw.humidity_pct === null ||\n  raw.humidity_pct === undefined ||\n  raw.humidity_pct === \"\"\n    ? \"\"\n    : Number(raw.humidity_pct);\n\nconst normalized = {\n  received_at: new Date().toISOString(),\n\n  device: String(raw.device || \"unknown\"),\n\n  time_ms: Number(raw.time_ms ?? 0),\n\n  ir: Number(raw.ir ?? 0),\n\n  obstacle: asBoolean(raw.obstacle),\n\n  pot_raw: Number(raw.pot_raw ?? 0),\n\n  pot_filtered: Number(raw.pot_filtered ?? 0),\n\n  stop_pressed: asBoolean(raw.stop_pressed),\n\n  ax: Number(raw.ax ?? 0),\n\n  ay: Number(raw.ay ?? 0),\n\n  az: Number(raw.az ?? 0),\n\n  shock_delta: Number(raw.shock_delta ?? 0),\n\n  humidity_pct: humidityValue,\n\n  bme_available: asBoolean(raw.bme_available),\n\n  state: String(raw.state || \"UNKNOWN\").toUpperCase(),\n\n  reason: String(raw.reason || \"UNKNOWN\"),\n\n  relay: String(raw.relay || \"OFF\").toUpperCase(),\n\n  remote_stop: asBoolean(raw.remote_stop),\n\n  rssi: Number(raw.rssi ?? 0)\n};\n\nreturn {\n  data: normalized\n};"
          },
          "defaultOutput": null
        },
        "inputs": null,
        "outputs": null
      },
